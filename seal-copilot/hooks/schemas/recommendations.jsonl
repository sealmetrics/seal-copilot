{
  "title": "recommendations.jsonl",
  "description": "The ledger that turns a report into consulting: every recommendation, what must move, and when to check.",
  "type": "object",
  "required": ["id", "date", "skill", "pattern", "subject", "evidence", "action", "impact_month", "currency", "metric", "baseline", "target", "verify_on", "status"],
  "additionalProperties": false,
  "x-synonyms": {
    "impact_eur_month": "impact_month",
    "impact": "impact_month",
    "impact_eur": "impact_month",
    "verify_date": "verify_on"
  },
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "<date>-<pattern>-<subject>, slugified. Used to detect repeats." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "skill": { "type": "string", "minLength": 1 },
    "pattern": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "impact_month": { "type": "number", "description": "Estimated monthly impact, in `currency`. Never in euros by default: a store reporting in USD cannot act on a figure in €." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "metric": { "type": "string", "minLength": 1 },
    "baseline": { "type": "number" },
    "target": { "type": "number" },
    "verify_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["open", "verified", "failed", "discarded"] },
    "notes": { "type": "string", "maxLength": 300 }
  }
}
